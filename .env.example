# ================================
# EventHub QA Automation - Environment Configuration
# ================================
# Copy this file to .env and fill in your values. NEVER commit .env.

# Environment key in src/data/environments.json
ENV=PROD

# EventHub account (register at https://eventhub.rahulshettyacademy.com/register)
EVENTHUB_USER_EMAIL=
EVENTHUB_USER_PASSWORD=

# Optional: HEADLESS=true hides the browser locally; SLOW_MO=500 slows each action (ms) so you can watch
HEADLESS=false
SLOW_MO=0
